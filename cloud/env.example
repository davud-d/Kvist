# Copy to cloud/.env and fill in. cloud/.env is ignored by git: never commit real keys.
# A real environment variable always wins over this file.

KVIST_CLOUD_SESSION_SECRET=
KVIST_CLOUD_MASTER_KEY=
PUBLIC_URL=https://cloud.example

# GitHub OAuth app: callback URL is <PUBLIC_URL>/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

BILLING_ENABLED=true
# "Sign in with ChatGPT" for customers' machines. Leave off until OpenAI has agreed to a hosted agent: many
# customers' plans used from one server address is what their abuse protection looks for.
CHATGPT_SIGNIN=false
# From the Platega cabinet: Settings
PLATEGA_MERCHANT_ID=
PLATEGA_SECRET=
# What each purchase costs, in PLATEGA_CURRENCY (RUB by default)
PLATEGA_PRICE_START=
PLATEGA_PRICE_PRO=
PLATEGA_PRICE_MAX=
PLATEGA_PRICE_HOURS=
# The Remote plan (your own machine): the price of a whole year
PLATEGA_PRICE_REMOTE=
# Optional, the ways to pay in the order shown: 2 SBP, 11 cards, 12 international, 13 crypto (default),
# also 3 ERIP, 14 Sberpay
# PLATEGA_PAYMENT_METHODS=2,11,12,13

# Apple Pay and Google Pay from the phone apps' own payment sheets (the money goes through Stripe).
# Off unless WALLET_ENABLED=true. Keys from the Stripe dashboard: use test keys until the apps are approved.
WALLET_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# The signing secret of the webhook endpoint <PUBLIC_URL>/billing/stripe/webhook
# (events: payment_intent.succeeded, charge.refunded, charge.dispute.created)
STRIPE_WEBHOOK_SECRET=
# Prices default to the plan table (start 15, pro 39, max 99, hours 5) in WALLET_CURRENCY (USD, EUR or GBP)
# WALLET_CURRENCY=USD
# WALLET_PRICE_START=15.00
# The country of the Stripe account and the name the sheets show
# WALLET_COUNTRY=US
# WALLET_MERCHANT_NAME=Kvist Cloud
# Google Pay: TEST works with no registration; PRODUCTION needs the merchant id from the Google Pay & Wallet Console
# GOOGLE_PAY_ENVIRONMENT=TEST
# GOOGLE_PAY_MERCHANT_ID=
# Apple Pay: the Merchant ID from the Apple developer account (and its certificate uploaded to Stripe)
# APPLE_PAY_MERCHANT_ID=merchant.site.kvist.cloud

# Freedom Pay (freedompay.kg): its hosted payment page, which shows its cards and, where connected, Apple Pay and
# Google Pay. Off unless FREEDOMPAY_ENABLED=true. Merchant id and the payment secret key come from the Freedom Pay
# personal account; the connection is arranged through its account manager.
FREEDOMPAY_ENABLED=false
FREEDOMPAY_MERCHANT_ID=
FREEDOMPAY_SECRET=
# What each purchase costs, in FREEDOMPAY_CURRENCY (KGS by default; ask which currencies the merchant may charge)
FREEDOMPAY_PRICE_START=
FREEDOMPAY_PRICE_PRO=
FREEDOMPAY_PRICE_MAX=
FREEDOMPAY_PRICE_HOURS=
# FREEDOMPAY_CURRENCY=KGS
# Test mode: Freedom Pay's test cards work and nothing is charged
# FREEDOMPAY_TESTING=true
