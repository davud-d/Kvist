# Copy to cloud/.env and fill in. cloud/.env is ignored by git: never commit real keys.
# A real environment variable always wins over this file.

KVIST_CLOUD_SESSION_SECRET=
KVIST_CLOUD_MASTER_KEY=
PUBLIC_URL=https://cloud.example

BILLING_ENABLED=true
# From the Platega cabinet: Settings
PLATEGA_MERCHANT_ID=
PLATEGA_SECRET=
# What each purchase costs, in PLATEGA_CURRENCY (RUB by default)
PLATEGA_PRICE_START=
PLATEGA_PRICE_PRO=
PLATEGA_PRICE_MAX=
PLATEGA_PRICE_HOURS=
# The Remote plan (your own machine): the price of a whole year
PLATEGA_PRICE_REMOTE=
# Optional, the ways to pay in the order shown: 2 SBP, 11 cards, 12 international, 13 crypto (default),
# also 3 ERIP, 14 Sberpay
# PLATEGA_PAYMENT_METHODS=2,11,12,13
