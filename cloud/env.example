# Copy to cloud/.env and fill in. cloud/.env is ignored by git: never commit real keys.
# A real environment variable always wins over this file.

KVIST_CLOUD_SESSION_SECRET=
KVIST_CLOUD_MASTER_KEY=
PUBLIC_URL=https://cloud.example

BILLING_ENABLED=true
# From the Platega cabinet: Settings
PLATEGA_MERCHANT_ID=
PLATEGA_SECRET=
# What each purchase costs, in PLATEGA_CURRENCY (RUB by default)
PLATEGA_PRICE_START=
PLATEGA_PRICE_PRO=
PLATEGA_PRICE_MAX=
PLATEGA_PRICE_HOURS=
# Optional: 11 cards (default), 2 SBP, 3 ERIP, 12 international, 13 crypto, 14 Sberpay
# PLATEGA_PAYMENT_METHOD=11
