<idea-plugin package="com.kvist.intellij">
    <id>com.kvist.intellij</id>
    <name>Kvist Launcher</name>
    <version>0.1.0</version>
    <vendor>Kvist</vendor>

    <description><![CDATA[
    The Kvist coding agent as a chat tool window (the same panel as the VS Code
    extension, in the IDE's embedded browser), a launcher that runs Kvist inside the
    IDE Terminal, and commit messages for the changes selected in the commit dialog.
    ]]></description>

    <idea-version since-build="253" />

    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.plugins.terminal</depends>
    <depends optional="true" config-file="kvist-git.xml">Git4Idea</depends>

    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="Kvist Notifications" displayType="BALLOON" isLogByDefault="false" />
        <toolWindow
            id="Kvist"
            anchor="right"
            icon="/icons/kvist.svg"
            canCloseContents="false"
            factoryClass="com.kvist.intellij.chat.KvistToolWindowFactory"
        />
    </extensions>

    <actions>
        <action
            id="com.kvist.intellij.RunKvistAction"
            class="com.kvist.intellij.actions.RunKvistAction"
            text="Run Kvist"
            icon="/icons/kvist.svg"
            description="Start Kvist in the IDE Terminal"
        >
            <add-to-group group-id="MainToolbarRight" anchor="last" />
            <add-to-group group-id="ToolsMenu" anchor="last" />
        </action>
    </actions>
</idea-plugin>