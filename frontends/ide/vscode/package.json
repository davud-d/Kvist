{
  "name": "kvist",
  "displayName": "Kvist",
  "description": "A coding agent in the side bar: it reads your code, edits files and runs tests in a sandbox. Bring your own model. Also commit messages and inline completion.",
  "version": "0.1.0",
  "publisher": "kvist",
  "icon": "resources/icon.png",
  "license": "MIT",
  "homepage": "https://kvist.site",
  "bugs": {
    "url": "https://github.com/davud-d/Kvist/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/davud-d/Kvist.git",
    "directory": "frontends/ide/vscode"
  },
  "galleryBanner": {
    "color": "#0f1722",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "AI",
    "Chat",
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "ai",
    "agent",
    "ai agent",
    "coding agent",
    "ai coding assistant",
    "autonomous agent",
    "llm",
    "chat",
    "code generation",
    "code completion",
    "inline completion",
    "refactoring",
    "code review",
    "commit message",
    "git",
    "terminal",
    "sandbox",
    "openai",
    "anthropic",
    "claude",
    "deepseek",
    "openrouter",
    "local llm",
    "byok",
    "multi-model"
  ],
  "activationEvents": [
    "onView:kvist.chat",
    "onStartupFinished"
  ],
  "main": "out/extension.js",
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "kvist-sidebar",
          "title": "Kvist",
          "icon": "resources/kvist.svg"
        }
      ]
    },
    "views": {
      "kvist-sidebar": [
        {
          "type": "webview",
          "id": "kvist.chat",
          "name": "Kvist"
        }
      ]
    },
    "submenus": [{ "id": "kvist.editor", "label": "Kvist" }],
    "commands": [
      { "command": "kvist.rewriteAsSenior", "title": "Rewrite as Senior", "category": "Kvist", "enablement": "editorHasSelection && !editorReadonly" },
      { "command": "kvist.translateSelection", "title": "Translate Selection", "category": "Kvist", "enablement": "editorHasSelection && !editorReadonly" },
      { "command": "kvist.explainAndFix", "title": "Explain and Fix", "category": "Kvist", "enablement": "editorHasSelection && !editorReadonly" },
      {
        "command": "kvist.focus",
        "title": "Open Kvist Chat",
        "category": "Kvist",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "kvist.openPage",
        "title": "Open Kvist in an Editor Tab",
        "category": "Kvist",
        "icon": { "light": "resources/kvist.svg", "dark": "resources/kvist.svg" }
      },
      {
        "command": "kvist.newSession",
        "title": "New Kvist Session",
        "category": "Kvist",
        "icon": "$(add)"
      },
      {
        "command": "kvist.settings",
        "title": "Kvist Settings",
        "category": "Kvist",
        "icon": "$(gear)"
      },
      {
        "command": "kvist.launch",
        "title": "Open Kvist in Terminal",
        "category": "Kvist",
        "icon": "$(terminal)"
      },
      {
        "command": "kvist.generateCommitMessage",
        "title": "Generate Commit Message with Kvist",
        "category": "Kvist",
        "icon": "$(sparkle)"
      }
    ],
    "menus": {
      "editor/context": [{ "submenu": "kvist.editor", "group": "1_modification@1" }],
      "kvist.editor": [
        { "command": "kvist.rewriteAsSenior", "group": "selection@1" },
        { "command": "kvist.translateSelection", "group": "selection@2" },
        { "command": "kvist.explainAndFix", "group": "selection@3" }
      ],
      "commandPalette": [
        {
          "command": "kvist.generateCommitMessage",
          "when": "scmProvider == git"
        }
      ],
      "editor/title": [{ "command": "kvist.openPage", "group": "navigation@1" }],
      "scm/title": [
        {
          "command": "kvist.generateCommitMessage",
          "group": "navigation",
          "when": "scmProvider == git"
        }
      ],
      "view/title": [
        {
          "command": "kvist.newSession",
          "group": "navigation@1",
          "when": "view == kvist.chat"
        },
        {
          "command": "kvist.settings",
          "group": "navigation@2",
          "when": "view == kvist.chat"
        }
      ]
    },
    "configuration": {
      "title": "Kvist",
      "properties": {
        "kvist.binaryPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the Kvist executable. Leave empty to use the binary bundled with the extension."
        },
        "kvist.environment": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "markdownDescription": "Environment variables for the Kvist core, applied on top of VS Code's own. For example `AGENT_SANDBOX_MODE` (`auto`, `workspace` or `bubblewrap`) and `AGENT_SANDBOX_NET` (`allow` or `deny`). Changes apply when the core restarts. Values are stored in plain text, so keep API keys in the provider settings instead."
        },
        "kvist.inlineCompletion.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show inline code completions (ghost text) as you type, generated by Kvist's fast model. Requests go to a dedicated completion process — they never wait behind a running agent turn."
        },
        "kvist.inlineCompletion.debounceMs": {
          "type": "number",
          "default": 100,
          "minimum": 0,
          "markdownDescription": "Milliseconds to wait after you stop typing before requesting an inline completion. Cached suggestions return immediately when you undo or delete a typo."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p . --noEmit && tsc -p webview --noEmit",
    "test": "tsx --test webview/*.test.ts src/*.test.ts",
    "lint": "eslint src --ext ts",
    "package": "vsce package --no-dependencies --skip-license",
    "package:proposals": "node package-proposals.mjs --skip-license"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.106.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vscode/vsce": "^2.22.0",
    "esbuild": "^0.28.2",
    "eslint": "^8.54.0",
    "tsx": "^4.23.15",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "lucide-preact": "^1.61.0",
    "markdown-it": "^15.0.2",
    "preact": "^10.29.8"
  }
}
