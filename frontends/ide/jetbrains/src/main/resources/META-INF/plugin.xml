<idea-plugin package="com.kvist.intellij">
    <id>com.kvist.agent</id>
    <name>Kvist</name>
    <version>0.1.0</version>
    <vendor url="https://kvist.site">Kvist</vendor>

    <description><![CDATA[
    <p>Kvist is a coding agent that works on one project folder at a time. You describe a task,
    it reads the code, edits files, runs commands and tests in a sandbox, and tells you what changed.
    It runs on your machine and uses the model provider you choose (AnyModel, OpenAI, Anthropic,
    DeepSeek, OpenRouter, ChatGPT sign-in, or any OpenAI-compatible endpoint).</p>
    <ul>
      <li>Chat tool window with streamed answers, diffs for every edit, and approvals before risky commands.</li>
      <li>Commit messages written from the changes selected in the commit dialog.</li>
      <li>Inline completion as ghost text, from your configured fast model.</li>
      <li>Editor context menu: Rewrite as Senior, Translate Selection, Explain and Fix. Each shows a diff first.</li>
      <li>The full-screen terminal interface inside the IDE Terminal.</li>
    </ul>
    <p>Commands run without network access and with a private home folder. Files named .env are never
    read, and /revert undoes what the agent wrote. Source and issues:
    <a href="https://github.com/davud-d/Kvist">github.com/davud-d/Kvist</a>.</p>
    <p><img src="https://raw.githubusercontent.com/davud-d/Kvist/main/frontends/ide/jetbrains/media/jetbrains-welcome.png" alt="The Kvist page in an editor tab" width="600"></p>
    <p><img src="https://raw.githubusercontent.com/davud-d/Kvist/main/frontends/ide/jetbrains/media/jetbrains-answer.png" alt="Kvist explaining a project" width="600"></p>
    <p><img src="https://raw.githubusercontent.com/davud-d/Kvist/main/frontends/ide/vscode/media/classic-ui.gif" alt="The Classic terminal interface" width="600"></p>
    <p><img src="https://raw.githubusercontent.com/davud-d/Kvist/main/frontends/ide/vscode/media/claude-style-ui.gif" alt="The Claude-style terminal interface" width="600"></p>
    ]]></description>

    <change-notes><![CDATA[
    <p>0.1.0: first public release. Chat tool window, commit messages, inline completion,
    selection actions, terminal launcher.</p>
    ]]></change-notes>

    <idea-version since-build="253" />

    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.plugins.terminal</depends>
    <!-- JCEF moved out of the platform in 2026.2; older 253 builds have no plugin alias. -->
    <depends optional="true" config-file="kvist-jcef.xml">com.intellij.modules.jcef</depends>
    <depends optional="true" config-file="kvist-git.xml">Git4Idea</depends>

    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="Kvist Notifications" displayType="BALLOON" isLogByDefault="false" />
        <toolWindow
            id="Kvist"
            anchor="right"
            icon="/icons/kvist.svg"
            canCloseContents="false"
            factoryClass="com.kvist.intellij.chat.KvistToolWindowFactory"
        />
        <fileEditorProvider implementation="com.kvist.intellij.editor.KvistPageEditorProvider" />
        <fileIconProvider implementation="com.kvist.intellij.editor.KvistPageIconProvider" order="first" />
        <iconProvider implementation="com.kvist.intellij.editor.KvistPageIconProvider" order="first, before IconProvider" />
        <editorTabTitleProvider implementation="com.kvist.intellij.editor.KvistPageTabTitleProvider" order="first" />
        <fileType name="Kvist" implementationClass="com.kvist.intellij.editor.KvistPageFileType" fieldName="INSTANCE" fileNames="Kvist" />
        <inline.completion.provider implementation="com.kvist.intellij.completion.KvistInlineCompletionProvider" />
    </extensions>

    <actions>
        <action
            id="com.kvist.intellij.RunKvistAction"
            class="com.kvist.intellij.actions.RunKvistAction"
            text="Open Kvist"
            icon="/icons/kvist.svg"
            description="Open the Kvist web page in an editor tab"
        >
            <add-to-group group-id="MainToolbarRight" anchor="last" />
            <add-to-group group-id="ToolsMenu" anchor="last" />
        </action>
        <action
            id="com.kvist.intellij.ToggleInlineCompletionAction"
            class="com.kvist.intellij.actions.ToggleInlineCompletionAction"
            text="Kvist Inline Completion"
            description="Toggle ghost-text inline completion from Kvist"
        >
            <add-to-group group-id="ToolsMenu" anchor="last" />
        </action>

        <group
            id="com.kvist.intellij.EditorPopupGroup"
            text="Kvist"
            icon="/icons/kvist.svg"
            popup="true"
        >
            <add-to-group group-id="EditorPopupMenu" anchor="first" />

            <action
                id="com.kvist.intellij.RewriteAsSeniorAction"
                class="com.kvist.intellij.actions.RewriteAsSeniorAction"
                text="Rewrite as Senior"
                description="Rewrite the selected code for readability without changing its behavior"
            />
            <action
                id="com.kvist.intellij.TranslateSelectionAction"
                class="com.kvist.intellij.actions.TranslateSelectionAction"
                text="Translate Selection"
                description="Translate the selected text, comment or string into another language"
            />
            <action
                id="com.kvist.intellij.ExplainAndFixAction"
                class="com.kvist.intellij.actions.ExplainAndFixAction"
                text="Explain and Fix"
                description="Explain the selected code, list its weak spots and propose a safe patch"
            />
        </group>
    </actions>
</idea-plugin>