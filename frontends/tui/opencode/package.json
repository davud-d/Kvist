{
  "name": "kvist-opencode",
  "version": "0.1.0",
  "private": true,
  "description": "OpenCode-style terminal frontend for Kvist: OpenTUI + SolidJS on Bun, driving the core over the stdio-multi NDJSON protocol",
  "type": "module",
  "license": "MIT",
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "start": "bun run src/main.ts",
    "typecheck": "tsc -p . --noEmit",
    "test": "bun test --timeout 30000"
  },
  "dependencies": {
    "@opentui/core": "0.6.6",
    "@opentui/keymap": "0.6.6",
    "@opentui/solid": "0.6.6",
    "effect": "4.0.1",
    "fuzzysort": "3.1.0",
    "get-east-asian-width": "1.6.0",
    "remeda": "2.26.0",
    "solid-js": "1.9.12",
    "string-width": "7.2.0",
    "strip-ansi": "7.1.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  },
  "imports": {
    "#string-width": {
      "bun": "./src/oc/tui/util/string-width.bun.ts",
      "node": "./src/oc/tui/util/string-width.node.ts",
      "default": "./src/oc/tui/util/string-width.bun.ts"
    }
  }
}
