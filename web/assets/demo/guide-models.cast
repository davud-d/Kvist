[3.156111, "o", "\u001b[1;36mOmniRoute Model Configuration\u001b[0m\r\r\n"]
[3.156474, "o", "\u001b[2mOmniRoute uses dynamic model ids — no static model list.\u001b[0m\r\r\n"]
[3.156894, "o", "\u001b[2mEnter model ids manually in provider/model format \u001b[0m\u001b[1;2m(\u001b[0m\u001b[2me.g. \u001b[0m\u001b[1;2mkr/claude-sonnet-\u001b[0m\u001b[1;2;36m4.5\u001b[0m\u001b[2m, \u001b[0m\r\r\n\u001b[1;2mds-web/deepseek-v4-pro\u001b[0m\u001b[1;2m)\u001b[0m\u001b[2m.\u001b[0m\r\r\n"]
[3.156954, "o", "\r\r\n"]
[3.157178, "o", "\u001b[1mCurrent models:\u001b[0m\r\r\n"]
[3.157303, "o", "  \u001b[36mFast    \u001b[0m local-fast\r\r\n"]
