[3.15767, "o", "\r\r\n"]
[3.157729, "o", "\u001b[2J\u001b[H"]
[3.158115, "o", "\u001b[96m╭─\u001b[0m\u001b[96m Select action: \u001b[0m\u001b[96m────────────────────────────────────────────────────────────────────────────────\u001b[0m\u001b[96m─╮\u001b[0m\r\r\n\u001b[96m│\u001b[0m                                                                                                  \u001b[96m│\u001b[0m\r\r\n\u001b[96m│\u001b[0m  \u001b[38;5;249mEnter — cancel and keep current models\u001b[0m                                                          \u001b[96m│\u001b[0m\r\r\n\u001b[96m│\u001b[0m                                                                                                  \u001b[96m│\u001b[0m\r\r\n\u001b[96m╰──────────────────────────────────────────────────────────────────────────────────────────────────╯\u001b[0m\r\r\n"]
[3.158629, "o", "\u001b[38;5;244m╭──────────────────────────────────────────────────────────────────────────────────────────────────╮\u001b[0m\r\r\n\u001b[38;5;244m│\u001b[0m \u001b[92m❯ \u001b[0m\u001b[1;92mEnter one model id for all roles\u001b[0m                                                               \u001b[38;5;244m│\u001b[0m\r\r\n\u001b[38;5;244m│\u001b[0m \u001b[38;5;244m  \u001b[0m\u001b[37mEnter a separate model id per role\u001b[0m                                                             \u001b[38;5;244m│\u001b[0m\r\r\n\u001b[38;5;244m│\u001b[0m \u001b[38;5;244m  \u001b[0m\u001b[37mKeep current models (unchanged)\u001b[0m                                                                \u001b[38;5;244m│\u001b[0m\r\r\n\u001b[38;5;244m╰──────────────────────────────────────────────────────────────────────────────────────────────────╯\u001b[0m\r\r\n"]
[5.966992, "o", "\u001b[2J\u001b[H"]
[5.967407, "o", "\u001b[96m╭─\u001b[0m\u001b[96m Select action: \u001b[0m\u001b[96m────────────────────────────────────────────────────────────────────────────────\u001b[0m\u001b[96m─╮\u001b[0m\r\r\n\u001b[96m│\u001b[0m                                                                                                  \u001b[96m│\u001b[0m\r\r\n\u001b[96m│\u001b[0m  \u001b[38;5;249mEnter — cancel and keep current models\u001b[0m                                                          \u001b[96m│\u001b[0m\r\r\n\u001b[96m│\u001b[0m                                                                                                  \u001b[96m│\u001b[0m\r\r\n\u001b[96m╰──────────────────────────────────────────────────────────────────────────────────────────────────╯\u001b[0m\r\r\n"]
[5.967851, "o", "\u001b[38;5;244m╭──────────────────────────────────────────────────────────────────────────────────────────────────╮\u001b[0m\r\r\n\u001b[38;5;244m│\u001b[0m \u001b[38;5;244m  \u001b[0m\u001b[37mEnter one model id for all roles\u001b[0m                                                               \u001b[38;5;244m│\u001b[0m\r\r\n\u001b[38;5;244m│\u001b[0m \u001b[92m❯ \u001b[0m\u001b[1;92mEnter a separate model id per role\u001b[0m                                                             \u001b[38;5;244m│\u001b[0m\r\r\n\u001b[38;5;244m│\u001b[0m \u001b[38;5;244m  \u001b[0m\u001b[37mKeep current models (unchanged)\u001b[0m                                                                \u001b[38;5;244m│\u001b[0m\r\r\n\u001b[38;5;244m╰──────────────────────────────────────────────────────────────────────────────────────────────────╯\u001b[0m\r\r\n"]
[7.171721, "o", "\u001b[2J\u001b[H"]
[7.172616, "o", "\u001b[96m╭─\u001b[0m\u001b[96m Enter OmniRoute model id for Fast role: \u001b[0m\u001b[96m───────────────────────────────────────────────────────\u001b[0m\u001b[96m─╮\u001b[0m\r\r\n\u001b[96m│\u001b[0m                                                                                                  \u001b[96m│\u001b[0m\r\r\n\u001b[96m│\u001b[0m  \u001b[38;5;249mUsed for routing, planning, chat, and simple steps — pick something quick and cheap.\u001b[0m            \u001b[96m│\u001b[0m\r\r\n\u001b[96m│\u001b[0m  \u001b[38;5;249mFormat: provider/model (e.g. ds-web/deepseek-v4-pro). Type 'auto' for OmniRoute auto-routing.\u001b[0m   \u001b[96m│\u001b[0m\r\r\n\u001b[96m│\u001b[0m                                                                                                  \u001b[96m│\u001b[0m\r\r\n\u001b[96m│\u001b[0m  \u001b[93mCurrent: local-fast\u001b[0m                                                                             \u001b[96m│\u001b[0m\r\r\n\u001b[96m│\u001b[0m                                                                                                  \u001b[96m│\u001b[0m\r\r\n\u001b[96m│\u001b[0m  \u001b[37mEnter value (Esc to cancel):\u001b[0m                                                                    \u001b[96m│\u001b[0m\r\r\n\u001b[96m│\u001b[0m                                                                                                  \u001b[96m│\u001b[0m\r\r\n\u001b[96m╰──────────────────────────────────────────────────────────────────────────────────────────────────╯\u001b[0m\r\r\n"]
